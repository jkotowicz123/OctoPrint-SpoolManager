<div id="tab_lowStockOverview">
    <div data-bind="visible: pluginNotWorking()==true">
        <div class="row-fluid">
            <font color="red"><b>Plugin not working, because of Database issues. Check Plugin-Settings!</b></font>
        </div>
    </div>
    <div data-bind="visible: pluginNotWorking()==false">

        <div class="dropdown pull-right tabdrop">
            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                <i class="icon-table"></i>
                <b class="caret"></b>
            </a>
            <ul class="dropdown-menu">
                <li>
                    <div style="margin-left: 10px; font-weight: bold;">Consumables</div>
                    <div style="margin-left: 10px;">
                        <label class="checkbox"><input type="checkbox" data-bind="checked: lowStockColVis.lp"> L.p.</label>
                        <label class="checkbox"><input type="checkbox" data-bind="checked: lowStockColVis.name"> Name</label>
                        <label class="checkbox"><input type="checkbox" data-bind="checked: lowStockColVis.barcode"> Barcode</label>
                        <label class="checkbox"><input type="checkbox" data-bind="checked: lowStockColVis.min"> Min</label>
                        <label class="checkbox"><input type="checkbox" data-bind="checked: lowStockColVis.count"> Count</label>
                        <label class="checkbox"><input type="checkbox" data-bind="checked: lowStockColVis.ordered"> Ordered</label>
                        <label class="checkbox"><input type="checkbox" data-bind="checked: lowStockColVis.deficit"> Deficit</label>
                    </div>
                    <div style="margin-left: 10px; margin-top: 6px; font-weight: bold;">Filament</div>
                    <div style="margin-left: 10px;">
                        <label class="checkbox"><input type="checkbox" data-bind="checked: lowStockColVis.filament"> Filament</label>
                        <label class="checkbox"><input type="checkbox" data-bind="checked: lowStockColVis.currentWeight"> Current (g)</label>
                        <label class="checkbox"><input type="checkbox" data-bind="checked: lowStockColVis.minWeight"> Min (g)</label>
                        <label class="checkbox"><input type="checkbox" data-bind="checked: lowStockColVis.filDeficit"> Deficit (g)</label>
                        <label class="checkbox"><input type="checkbox" data-bind="checked: lowStockColVis.spoolsToOrder"> Spools to order</label>
                        <label class="checkbox"><input type="checkbox" data-bind="checked: lowStockColVis.filOrdered"> Ordered</label>
                    </div>
                </li>
            </ul>
        </div>

        <h4>Consumables <small data-bind="visible: lowStockConsumables().length > 0">(<span data-bind="text: lowStockConsumables().length"></span> low)</small></h4>

        <!-- ko if: lowStockConsumables().length === 0 -->
        <p style="color: #999;">All consumables are above minimum stock levels.</p>
        <!-- /ko -->

        <!-- ko if: lowStockConsumables().length > 0 -->
        <!-- ko foreach: lowStockConsumablesByCategory -->
        <h5 style="margin-top: 12px; margin-bottom: 4px;" data-bind="text: category"></h5>
        <table class="table table-striped table-condensed" style="margin-bottom: 8px;">
            <thead>
                <tr>
                    <th data-bind="visible: $root.lowStockColVis.lp" style="width: 4%">L.p.</th>
                    <th data-bind="visible: $root.lowStockColVis.name" style="width: 28%">Name</th>
                    <th data-bind="visible: $root.lowStockColVis.barcode" style="width: 10%">Barcode</th>
                    <th data-bind="visible: $root.lowStockColVis.min" style="width: 8%">Min</th>
                    <th data-bind="visible: $root.lowStockColVis.count" style="width: 8%">Count</th>
                    <th data-bind="visible: $root.lowStockColVis.ordered" style="width: 12%">Ordered</th>
                    <th data-bind="visible: $root.lowStockColVis.deficit" style="width: 8%">Deficit</th>
                </tr>
            </thead>
            <tbody data-bind="foreach: items">
                <tr style="cursor: pointer;" data-bind="css: { 'spm-low-stock': parseInt(ordered()) <= 0 || isNaN(parseInt(ordered())), 'spm-low-stock-ordered': parseInt(ordered()) > 0 }">
                    <td style="color: #999;" data-bind="text: $index() + 1, visible: $root.lowStockColVis.lp"></td>
                    <td data-bind="click: function(){ $root.editConsumable($data); }, visible: $root.lowStockColVis.name"><span data-bind="text: name"></span></td>
                    <td data-bind="visible: $root.lowStockColVis.barcode"><span data-bind="text: barcode"></span></td>
                    <td data-bind="visible: $root.lowStockColVis.min"><span data-bind="text: minStockCount"></span></td>
                    <td data-bind="visible: $root.lowStockColVis.count"><span data-bind="text: count"></span></td>
                    <td style="white-space: nowrap;" data-bind="visible: $root.lowStockColVis.ordered">
                        <!-- ko if: parseInt(packUnits()) > 1 -->
                        <button class="btn btn-mini" data-bind="click: function(){ $root.adjustConsumableOrdered($data, -parseInt(packUnits())); }"><i class="icon-minus"></i></button>
                        <span style="display: inline-block; min-width: 24px; text-align: center;" data-bind="text: Math.floor((parseInt(ordered()) || 0) / parseInt(packUnits())) + ' op.'"></span>
                        <button class="btn btn-mini" data-bind="click: function(){ $root.adjustConsumableOrdered($data, parseInt(packUnits())); }"><i class="icon-plus"></i></button>
                        <div style="font-size: 10px; color: #888; text-align: center;" data-bind="text: (parseInt(ordered()) || 0) + ' szt.'"></div>
                        <!-- /ko -->
                        <!-- ko ifnot: parseInt(packUnits()) > 1 -->
                        <button class="btn btn-mini" data-bind="click: function(){ $root.adjustConsumableOrdered($data, -1); }"><i class="icon-minus"></i></button>
                        <span style="display: inline-block; min-width: 24px; text-align: center;" data-bind="text: ordered"></span>
                        <button class="btn btn-mini" data-bind="click: function(){ $root.adjustConsumableOrdered($data, 1); }"><i class="icon-plus"></i></button>
                        <!-- /ko -->
                    </td>
                    <td data-bind="visible: $root.lowStockColVis.deficit"><b><span data-bind="text: $root.consumableDeficit($data)"></span></b></td>
                </tr>
            </tbody>
        </table>
        <!-- /ko -->
        <!-- /ko -->

        <hr/>

        <h4>Filament <small data-bind="visible: lowStockSpoolGroups().length > 0">(<span data-bind="text: lowStockSpoolGroups().length"></span> low)</small></h4>

        <!-- ko if: lowStockSpoolGroups().length === 0 -->
        <p style="color: #999;">All filament types are above minimum stock levels.</p>
        <!-- /ko -->

        <!-- ko if: lowStockSpoolGroups().length > 0 -->
        <table class="table table-striped table-condensed">
            <thead>
                <tr>
                    <th data-bind="visible: lowStockColVis.filament" style="width: 25%">Filament</th>
                    <th data-bind="visible: lowStockColVis.currentWeight" style="width: 12%">Current (g)</th>
                    <th data-bind="visible: lowStockColVis.minWeight" style="width: 10%">Min (g)</th>
                    <th data-bind="visible: lowStockColVis.filDeficit" style="width: 10%">Deficit (g)</th>
                    <th data-bind="visible: lowStockColVis.spoolsToOrder" style="width: 20%">Spools to order</th>
                    <th data-bind="visible: lowStockColVis.filOrdered" style="width: 15%">Ordered</th>
                </tr>
            </thead>
            <tbody data-bind="foreach: lowStockSpoolGroups">
                <tr data-bind="css: { 'spm-low-stock': !orderedTotal, 'spm-low-stock-ordered': orderedTotal > 0 }">
                    <td data-bind="visible: $root.lowStockColVis.filament"><b><span data-bind="text: displayName"></span></b></td>
                    <td data-bind="visible: $root.lowStockColVis.currentWeight"><span data-bind="text: currentWeight"></span></td>
                    <td data-bind="visible: $root.lowStockColVis.minWeight"><span data-bind="text: minStockWeight"></span></td>
                    <td data-bind="visible: $root.lowStockColVis.filDeficit"><b><span data-bind="text: deficit"></span></b></td>
                    <td data-bind="visible: $root.lowStockColVis.spoolsToOrder"><b><span data-bind="text: spoolsToOrder"></span></b></td>
                    <td style="white-space: nowrap;" data-bind="visible: $root.lowStockColVis.filOrdered">
                        <!-- single spool size: simple +/- -->
                        <!-- ko if: singleSize && orderedSizes.length === 1 -->
                        <button class="btn btn-mini" data-bind="click: function(){ $root.adjustFilamentOrdered(displayName, orderedSizes[0].weight, -1); }"><i class="icon-minus"></i></button>
                        <span style="display: inline-block; min-width: 24px; text-align: center;" data-bind="text: orderedSizes[0].count"></span>
                        <button class="btn btn-mini" data-bind="click: function(){ $root.adjustFilamentOrdered(displayName, orderedSizes[0].weight, 1); }"><i class="icon-plus"></i></button>
                        <!-- /ko -->
                        <!-- multiple spool sizes: +/- per size -->
                        <!-- ko if: !singleSize && orderedSizes.length > 1 -->
                        <!-- ko foreach: orderedSizes -->
                        <div style="margin-bottom: 2px;">
                            <span style="display: inline-block; min-width: 50px; font-size: 11px;" data-bind="text: weight + 'g:'"></span>
                            <button class="btn btn-mini" data-bind="click: function(){ $root.adjustFilamentOrdered($parent.displayName, weight, -1); }"><i class="icon-minus"></i></button>
                            <span style="display: inline-block; min-width: 24px; text-align: center;" data-bind="text: count"></span>
                            <button class="btn btn-mini" data-bind="click: function(){ $root.adjustFilamentOrdered($parent.displayName, weight, 1); }"><i class="icon-plus"></i></button>
                        </div>
                        <!-- /ko -->
                        <!-- /ko -->
                        <!-- no spool data -->
                        <!-- ko if: orderedSizes.length === 0 -->
                        <span>-</span>
                        <!-- /ko -->
                    </td>
                </tr>
            </tbody>
        </table>
        <!-- /ko -->

    </div>
</div>
