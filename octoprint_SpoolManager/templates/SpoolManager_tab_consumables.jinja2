<div id="tab_consumablesOverview">
    <div data-bind="visible: pluginNotWorking()==true">
        <div class="row-fluid">
            <font color="red"><b>Plugin not working, because of Database issues. Check Plugin-Settings!</b></font>
        </div>
    </div>
    <div data-bind="visible: pluginNotWorking()==false">
        <div class="row-fluid">
            <div class="span3">
                Total: <b><span data-bind="text: consumablesTotalCount"></span></b>
                <div class="pull-left">
                    <button title="Add new Consumable" class="btn" data-bind="click: addNewConsumable"><i class="fa fa-plus"></i> Add</button>
                    <span class="btn fileinput-button" style="margin-left: 4px;">
                        <span><i class="fa fa-upload"></i> CSV...</span>
                        <input id="consumables-importcsv-upload"
                               type="file"
                               name="file"
                               data-url="/plugin/SpoolManager/importConsumablesCSV"
                               accept=".csv">
                    </span>
                    <span class="add-on" data-bind="text: consumablesCsvFileUploadName, visible: consumablesCsvFileUploadName"></span>
                    <button class="btn btn-primary btn-small"
                            data-bind="visible: consumablesCsvFileUploadName, disable: consumablesCsvImportInProgress, click: performConsumablesCsvImport">
                        <i class="fa fa-spinner fa-spin"
                           data-bind="visible: consumablesCsvImportInProgress"></i> Import
                    </button>
                </div>
            </div>
            <div class="span9">
                <div class="pull-right">
                    <small>
                        Scan barcode:
                        <input type="text" class="input-medium" data-bind="textInput: consumableScanBarcode, event: { keyup: onConsumableScanKeyUp }" placeholder="Barcode..." />
                        <button class="btn btn-mini" data-bind="click: consumableScanAdjustMinus">-1</button>
                        <button class="btn btn-mini" data-bind="click: consumableScanAdjustPlus">+1</button>
                        <button class="btn btn-mini" data-bind="click: consumableScanLookup">Lookup</button>
                    </small>
                </div>
            </div>
        </div>

        <div class="pull-left" style="margin-bottom: 6px;">
            <div style="margin-top:5px;" class="pull-right search-query-with-clear active-clear" data-bind="css: {'active-clear': consumableFilterQuery}">
                <input type="search" class="input-block search-query" data-bind="value: consumableFilterQuery, valueUpdate: 'input'" placeholder="Filter...">
                <span class="search-clear" data-bind="click: clearConsumableFilterQuery"><i class="fas fa-times"></i></span>
            </div>
        </div>

        <table class="table table-striped table-hover table-condensed table-hover" style="clear: both;">
            <thead>
                <tr>
                    <th style="width: 5%">ID</th>
                    <th style="width: 25%">Name</th>
                    <th style="width: 12%">Barcode</th>
                    <th style="width: 12%">Product code</th>
                    <th style="width: 10%">Pack</th>
                    <th style="width: 8%">Pack price</th>
                    <th style="width: 6%">Count</th>
                    <th style="width: 6%">Ordered</th>
                    <th style="width: 16%"></th>
                </tr>
            </thead>

            <tbody data-bind="foreach: groupedConsumables">
                <tr class="spm-group-header" style="cursor: pointer;" data-bind="click: function() { expanded(!expanded()); }">
                    <td colspan="9" style="padding-left: 0;">
                        <i data-bind="css: expanded() ? 'icon-chevron-down' : 'icon-chevron-right'"></i>
                        <b><span data-bind="text: category"></span></b>
                        <span style="color: #999;">(<span data-bind="text: items.length"></span>)</span>
                    </td>
                </tr>

                <!-- ko if: expanded -->
                <!-- ko foreach: items -->
                <tr data-bind="click: function() { $root.editConsumable($data); }">
                    <td><span data-bind="text: databaseId"></span></td>
                    <td><span data-bind="text: name"></span></td>
                    <td><span data-bind="text: barcode"></span></td>
                    <td><span data-bind="text: productCode"></span></td>
                    <td><span data-bind="text: packUnitsLabel"></span></td>
                    <td><span data-bind="text: packPriceGross"></span></td>
                    <td><span data-bind="text: count"></span></td>
                    <td><span data-bind="text: ordered"></span></td>
                    <td style="white-space: nowrap; text-align: right;" data-bind="click: function(){}, clickBubble: false">
                        <button class="btn btn-mini" data-bind="click: function(){ $root.adjustConsumableCount($data, -1); }">-1</button>
                        <button class="btn btn-mini" data-bind="click: function(){ $root.adjustConsumableCount($data, 1); }">+1</button>
                    </td>
                </tr>
                <!-- /ko -->
                <!-- /ko -->
            </tbody>
        </table>
    </div>
</div>
