<div id="sidebar_spool_select" class="control-group">

    <div id="selectedSpools" data-bind="foreach: selectedSpoolsForSidebar">
        <div>
            <!-- ko if: $parent.selectedSpoolsForSidebar().length > 1 -->
            <div>
                <b><span data-bind="text: $index() + 1"></span>:</b>
            </div>
            <!-- /ko -->
            <!-- ko ifnot: $data -->
            <div class="spool-label">
                <i>No spool selected</i>
            </div>
            <div>
                <div class="btn-group">
                    <button class="btn btn-mini"
                            data-bind="click: $parent.sidebarOpenSelectSpoolDialog.bind($data, $index())"
                            title="Change Spool">...</button>
                </div>
            </div>
            <!-- /ko -->
            <!-- ko if: $data -->
            <div>
                <span class="color-preview"
                      data-bind="style: {'background-color': color}, attr: { title: colorName }"></span>
            </div>
            <div class="spool-label">
                <b><span data-bind="text:databaseId"></span></b>
                <!-- ko if: material -->
                <span data-bind="text: material"></span> -
                <!-- /ko -->
                <span data-bind="text: displayName"></span>
                <!-- ko if: vendor -->
                (<span data-bind="text: vendor"></span>)
                <!-- /ko -->
                <span data-bind="text: $root.remainingText($data), attr: {title: $root.buildTooltipForSpoolItem($data, 'Remaining weight: ', 'remainingWeight')}"
                      class="spool-remaining" title="Remaining weight"></span>
            </div>
            <div>
                <div class="btn-group">
                    <button class="btn btn-mini" data-bind="click: $parent.editSpoolFromSidebar.bind($data, $index())"
                            title="Edit Spool"><span class="icon-edit"></span></button>
                    <button class="btn btn-mini"
                            data-bind="click: $parent.deselectSpoolForSidebar.bind($data, $index())"
                            title="Deselect Spool"><span class="icon-remove"></span></button>
                    <button class="btn btn-mini"
                            data-bind="click: $parent.sidebarOpenSelectSpoolDialog.bind($data, $index())"
                            title="Change Spool">...</button>
                </div>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <div style="margin-top: 10px;" data-bind="visible: pluginNotWorking()==false">
        <div data-bind="visible: currentPrinterNumber() != null">
            <div>
                <b>Sheets</b>
            </div>

            <div style="margin-top: 6px;">
                <!-- ko if: sidebarCurrentSheet -->
                <div data-bind="with: sidebarCurrentSheet">
                    <div>
                        <span data-bind="visible: sheetTypeName, text: sheetTypeName"></span>
                        <span data-bind="visible: !sheetTypeName()">Unknown</span>
                        <span class="pull-right">
                            <button class="btn btn-mini" data-bind="click: $root.sidebarUnassignSheet.bind($data, $data)" title="Unassign"><span class="icon-remove"></span></button>
                        </span>
                    </div>
                </div>
                <!-- /ko -->
                <!-- ko ifnot: sidebarCurrentSheet -->
                <div><i>None</i></div>
                <!-- /ko -->
            </div>

            <div style="margin-top: 6px;" data-bind="visible: pluginSettings.showSheetMagazineInSidebar">
                <div><b>Magazine</b></div>
                <!-- ko if: sidebarMagazineSheets().length == 0 -->
                <div><i>Empty</i></div>
                <!-- /ko -->
                <div data-bind="foreach: sidebarMagazineSheets">
                    <div style="margin-top: 2px;">
                        <span data-bind="text: magazinePosition"></span>.
                        <span data-bind="visible: sheetTypeName, text: sheetTypeName"></span>
                        <span data-bind="visible: !sheetTypeName()">Unknown</span>
                        <div class="btn-group" style="margin-top: 2px;">
                            <button class="btn btn-mini" data-bind="click: $root.sidebarSetSheetFromMagazine.bind($data, $data)">Set</button>
                            <button class="btn btn-mini" data-bind="click: $root.sidebarUnassignSheet.bind($data, $data)">Remove</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div data-bind="visible: currentPrinterNumber() == null" style="margin-top: 10px;">
            <div>
                <b>Sheets</b>
            </div>
            <div><i>Unavailable</i></div>
        </div>
    </div>
</div>
