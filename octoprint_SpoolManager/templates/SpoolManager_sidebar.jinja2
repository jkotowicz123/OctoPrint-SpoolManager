<div id="sidebar_spool_select" class="control-group">

    <div id="selectedSpools" data-bind="foreach: selectedSpoolsForSidebar">
        <div>
            <!-- ko if: $parent.selectedSpoolsForSidebar().length > 1 -->
            <div>
                <b><span data-bind="text: $index() + 1"></span>:</b>
            </div>
            <!-- /ko -->
            <!-- ko ifnot: $data -->
            <div class="spool-label">
                <i>No spool selected</i>
            </div>
            <div>
                <div class="btn-group">
                    <button class="btn btn-mini"
                            data-bind="click: $parent.sidebarOpenSelectSpoolDialog.bind($data, $index())"
                            title="Change Spool">...</button>
                </div>
            </div>
            <!-- /ko -->
            <!-- ko if: $data -->
            <div>
                <span class="color-preview"
                      data-bind="style: {'background-color': color}, attr: { title: colorName }"></span>
            </div>
            <div class="spool-label">
                <b><span data-bind="text:databaseId"></span></b>
                <!-- ko if: material -->
                <span data-bind="text: material"></span> -
                <!-- /ko -->
                <span data-bind="text: displayName"></span>
                <!-- ko if: vendor -->
                (<span data-bind="text: vendor"></span>)
                <!-- /ko -->
                <span data-bind="text: $root.remainingText($data), attr: {title: $root.buildTooltipForSpoolItem($data, 'Remaining weight: ', 'remainingWeight')}"
                      class="spool-remaining" title="Remaining weight"></span>
            </div>
            <div>
                <div class="btn-group">
                    <button class="btn btn-mini" data-bind="click: $parent.editSpoolFromSidebar.bind($data, $index())"
                            title="Edit Spool"><span class="icon-edit"></span></button>
                    <button class="btn btn-mini"
                            data-bind="click: $parent.deselectSpoolForSidebar.bind($data, $index())"
                            title="Deselect Spool"><span class="icon-remove"></span></button>
                    <button class="btn btn-mini"
                            data-bind="click: $parent.sidebarOpenSelectSpoolDialog.bind($data, $index())"
                            title="Change Spool">...</button>
                </div>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <div style="margin-top: 10px;" data-bind="visible: mmuRoutingAppliesHere">
        <div>
            <b>MMU Routing</b>
            <span class="label"
                  data-bind="text: mmuRoutingEnabled() ? 'ON' : 'OFF', css: {'label-success': mmuRoutingEnabled()}"></span>
        </div>
        <div style="margin-top: 3px;">
            <span data-bind="text: mmuRoutingStateText"></span>
            <span data-bind="visible: mmuRoutingDryRun" class="label label-warning">DRY RUN</span>
        </div>
        <div style="margin-top: 4px;">
            <button class="btn btn-mini"
                    data-bind="click: toggleMmuRouting, enable: mmuRoutingCanToggle, text: mmuRoutingEnabled() ? 'Disable routing' : 'Enable routing'">
            </button>
            <span data-bind="visible: mmuRoutingBusy"><i class="icon-spinner icon-spin"></i></span>
        </div>
    </div>

    <div style="margin-top: 10px;" data-bind="visible: pluginNotWorking()==false">
        <div data-bind="visible: currentPrinterNumber() != null">
            <div>
                <b>Sheets</b>
                <button class="btn btn-mini pull-right"
                        data-bind="click: sidebarToggleSheetPicker, disable: sidebarSheetAssignmentBusy">
                    <span data-bind="text: sidebarSheetPickerOpen() ? 'Zamknij listę' : 'Przypisz płyty'"></span>
                </button>
            </div>

            <div data-bind="visible: sidebarSheetPickerOpen" style="clear:both; margin-top:7px; padding:7px; border:1px solid #ddd; border-radius:4px;">
                <input type="search" class="input-block-level" style="margin-bottom:5px;"
                       placeholder="Szukaj ID, typu lub opisu"
                       data-bind="value: sidebarSheetPickerQuery, valueUpdate: 'input', disable: sidebarSheetAssignmentBusy">
                <div style="max-height:190px; overflow-y:auto; border-top:1px solid #eee;">
                    <!-- ko if: sidebarAvailableSheets().length == 0 -->
                    <div style="padding:6px 0;"><i>Brak wolnych płyt</i></div>
                    <!-- /ko -->
                    <div data-bind="foreach: sidebarAvailableSheets">
                        <div style="display:flex; align-items:center; gap:5px; padding:4px 0; border-bottom:1px solid #eee;">
                            <input type="checkbox"
                                   data-bind="checked: $root.sidebarSelectedSheetIds, checkedValue: databaseId(), disable: $root.sidebarSheetAssignmentBusy">
                            <span style="min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                  data-bind="attr: {title: note}">
                                <b>#<span data-bind="text: databaseId"></span></b>
                                <span data-bind="text: sheetTypeName() || 'Unknown'"></span>
                            </span>
                            <button class="btn btn-mini" title="Ustaw jako płytę na stole"
                                    data-bind="click: $root.sidebarSetAvailableSheetCurrent.bind($data, $data), disable: $root.sidebarSheetAssignmentBusy">Stół</button>
                        </div>
                    </div>
                </div>
                <div style="display:flex; gap:4px; margin-top:6px; align-items:center;">
                    <button class="btn btn-mini btn-primary" style="flex:1;"
                            data-bind="click: sidebarAppendSelectedSheets, disable: sidebarSheetAssignmentBusy() || sidebarSelectedSheetCount() == 0">
                        Do magazynka (<span data-bind="text: sidebarSelectedSheetCount"></span>)
                    </button>
                    <button class="btn btn-mini" title="Wyczyść zaznaczenie"
                            data-bind="click: sidebarClearSheetSelection, disable: sidebarSheetAssignmentBusy">×</button>
                </div>
                <div style="margin-top:4px; font-size:11px; line-height:1.25;"
                     data-bind="visible: sidebarSheetAssignmentStatus, text: sidebarSheetAssignmentStatus"></div>
            </div>

            <div style="margin-top: 6px;">
                <!-- ko if: sidebarCurrentSheet -->
                <div data-bind="with: sidebarCurrentSheet">
                    <div>
                        <span data-bind="visible: sheetTypeName, text: sheetTypeName"></span>
                        <span data-bind="visible: !sheetTypeName()">Unknown</span>
                        <span data-bind="visible: databaseId() != null"> (<span data-bind="text: databaseId"></span>)</span>
                    </div>
                    <div class="btn-group" style="margin-top: 2px;">
                        <button class="btn btn-mini" data-bind="click: $root.sidebarUnassignSheet.bind($data, $data)">Unassign</button>
                    </div>
                </div>
                <!-- /ko -->
                <!-- ko ifnot: sidebarCurrentSheet -->
                <div><i>None</i></div>
                <!-- /ko -->
            </div>

            <div style="margin-top: 8px; padding-top: 6px; border-top: 1px solid #ddd;">
                <div><b>Magazynek (<span data-bind="text: sidebarMagazineSheets().length"></span>)</b></div>
                <!-- ko if: sidebarMagazineSheets().length == 0 -->
                <div><i>Pusty</i></div>
                <!-- /ko -->
                <div data-bind="foreach: sidebarMagazineSheets">
                    <div style="display:flex; gap:5px; align-items:center; margin-top:4px;">
                        <span style="min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                            <b><span data-bind="text: magazinePosition"></span>.</b>
                            <span data-bind="visible: sheetTypeName, text: sheetTypeName"></span>
                            <span data-bind="visible: !sheetTypeName()">Nieznana</span>
                            <span data-bind="visible: databaseId() != null"> (#<span data-bind="text: databaseId"></span>)</span>
                        </span>
                        <div class="btn-group">
                            <button class="btn btn-mini" title="Przenieś płytę z magazynka na stół"
                                    data-bind="click: $root.sidebarSetSheetFromMagazine.bind($data, $data)">Na stół</button>
                            <button class="btn btn-mini" title="Usuń przypisanie płyty do drukarki"
                                    data-bind="click: $root.sidebarUnassignSheet.bind($data, $data)">Odepnij</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div data-bind="visible: currentPrinterNumber() == null" style="margin-top: 10px;">
            <div>
                <b>Sheets</b>
            </div>
            <div><i>Unavailable</i></div>
        </div>
    </div>
</div>
